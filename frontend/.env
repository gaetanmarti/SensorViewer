# Backend API URL
# Leave empty for same-origin deployments (e.g. .NET server that serves both static
# files and the API). The browser will use relative URLs that resolve to the serving host.
# Set a full URL only when the API is on a different host/port than the frontend.
#VITE_API_BASE_URL=http://imm-xxxx.tail99cfe0.ts.net:8080
#VITE_API_BASE_URL=http://192.168.4.50:8080
#VITE_API_BASE_URL=http://localhost:8080


# Configuration when running inside the backend server (e.g. .NET) that serves both the frontend and backend API.
VITE_API_BASE_URL=
